<?xml version="1.0" encoding="utf-8"?>
<!-- Misri Phone Cleaner overlay (Run #9) — SD Maid ki AppCleaner screen jaisa:
     Settings ke upar tairta hai, beech me Misri ka avatar, neeche progress card.
     Avatar = app icon (@mipmap/ic_launcher_round — final APK me user ka Misri logo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivOverlayAvatar"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Misri"
        android:src="@mipmap/ic_launcher_round" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pink_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Misri cache clear kar rahi hai…"
            android:textColor="#4A1030"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Abhi: —"
            android:textColor="#8A3A66"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/overlayProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvOverlayPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="0%"
            android:textColor="#4A1030"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOverlayCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done: 0 • Fail: 0 • Skip: 0"
            android:textColor="#8A3A66"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOverlayCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pink_button"
            android:text="Cancel karo"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
